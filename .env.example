# Copy this file to .env (repo root or Backend/) and fill in your key.
GROQ_API_KEY=your_groq_api_key_here

# Speech recognition
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Optional — uncomment to change the defaults
# LLM_MODEL=openai/gpt-oss-20b          # fast model: classification, summaries
# AGENT_MODEL=openai/gpt-oss-120b       # agent that talks to the caller
# WHISPER_LANGUAGE=en                   # language a call starts in; empty = auto-detect
# TTS_VOICES=hi:hi_IN-pratham-medium    # extra Piper voices as lang:model pairs
# PUBLIC_HOST=abc123.ngrok-free.app     # public host for the Twilio phone bridge
